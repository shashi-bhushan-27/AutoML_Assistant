# The repository root ignores *.csv / *.json / *.pkl; results of the ablation are
# small and are meant to be versioned, so re-include them here.
!results/
!results/*.csv
!results/*.json
!results/raw/
!results/raw/*.json
!results/raw/*.jsonl
# re-run after the fixes (ablation/run_ablation.py --out results_after_fixes ...)
!results_after_fixes/
!results_after_fixes/*.csv
!results_after_fixes/*.json
!results_after_fixes/raw/
!results_after_fixes/raw/*.json
!results_after_fixes/raw/*.jsonl
# throwaway smoke-test runs
results_smoketest/
figures_smoketest/
# Local caches (datasets, temporary workspaces) are never committed.
.cache/
_tmp/
__pycache__/

# The merged paper draft is delivered to the authors, not published in this public repository.
paper_with_ablation.tex
